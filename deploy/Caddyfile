# Caddy는 DOMAIN에 대해 Let's Encrypt 인증서를 자동으로 발급·갱신한다.
#
# 중요 — Cloudflare를 앞에 둘 때의 함정:
#   주황색 구름(프록시 ON) 상태면 Caddy의 HTTP-01 갱신 요청이 Cloudflare에
#   가로채여 60일 뒤 갱신이 조용히 실패한다. 두 가지 중 하나를 택할 것.
#
#   (A) 회색 구름(DNS only)로 두고 Caddy가 인증서를 관리 — 지금 설정.
#       가장 단순하고 바로 동작한다. Cloudflare 캐시·WAF는 못 쓴다.
#
#   (B) 주황색 구름 + Cloudflare Origin Certificate — 캐시/WAF를 쓰려면 이쪽.
#       CF 대시보드에서 Origin Certificate를 만들어(15년, 갱신 불필요)
#       호스트의 ./deploy/certs/ 에 두고 아래 tls 줄의 주석을 해제한 뒤,
#       CF의 SSL 모드를 반드시 "Full (strict)"로 바꾼다.
#       compose의 caddy 볼륨에 `- ./deploy/certs:/certs:ro` 를 추가할 것.

# www -> apex 리다이렉트.
#
# DNS에 www 레코드를 두면 Caddy에도 사이트 블록이 있어야 한다. 없으면
# www로 온 요청은 매칭되는 인증서가 없어 TLS 핸드셰이크 단계에서 끊긴다
# (브라우저에 "안전하지 않은 연결"이 뜬다). 실제로 이걸로 한 번 걸렸다.
#
# DOMAIN과 별도 변수를 쓰는 이유: 도메인 없이 IP로 띄워 검증할 때
# DOMAIN=:80을 쓰는데, `www.{$DOMAIN}`이면 "www.:80"이 되어 Caddy 설정
# 자체가 로드에 실패한다. 기본값 www.localhost는 Caddy가 내부 CA로
# 처리하므로 공개 ACME를 두드리지 않는다.
{$WWW_DOMAIN:www.localhost} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# (B)를 쓸 때 주석 해제하고 위 automatic HTTPS를 대체한다
	# tls /certs/origin.pem /certs/origin.key

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# FastAPI가 market snapshot별 TTL을 정한다. 모든 /api 응답을 여기서
	# no-store로 덮어쓰면 macro/weekend의 짧은 public cache가 무효가 된다.
	# 계산량이 크거나 운영 상태를 담는 엔드포인트만 캐시하지 않는다.
	@uncached_api path /api/metrics* /api/correlation* /api/status /api/health
	header @uncached_api Cache-Control "no-store"

	reverse_proxy web:8000 {
		# DNS-only mode: replace, do not append to, public forwarding headers.
		# This keeps application rate limits from being bypassed by spoofed IPs.
		header_up X-Forwarded-For {remote_host}
		header_up -CF-Connecting-IP
		health_uri /api/health
		health_interval 15s
		health_timeout 5s
	}

	log {
		output stdout
		format console
	}
}
