# EC2의 /opt/stock-metrics/.env 로 복사해 쓴다. 저장소에 커밋하지 말 것.

# --- 필수 -------------------------------------------------------------------
# Caddy가 이 도메인으로 인증서를 발급받는다. DNS가 먼저 이 인스턴스를
# 가리키고 있어야 한다.
DOMAIN=stock.example.com

# bootstrap.sh가 무작위로 채운다. 직접 정하지 말 것.
POSTGRES_PASSWORD=

# GitHub Actions가 배포할 때마다 덮어쓴다. 최초 기동용으로만 채워 둔다.
IMAGE=ghcr.io/OWNER/stock-metrics-calculator:latest

# --- 선택 -------------------------------------------------------------------
# gunicorn 워커 수. t4g.small(2 vCPU)이면 2가 적정.
WEB_CONCURRENCY=2

# 수집 주기(초)와 1회 실행당 티커 수. 야후가 자주 막히면 배치를 줄이고
# 간격을 늘린다.
INGEST_INTERVAL=3600
INGEST_BATCH_SIZE=40
INGEST_DELAY=1.5

# 조회가 없어도 항상 최신으로 유지할 티커
SEED_TICKERS=AAPL,MSFT,SPY,QQQ

# 가격이 이보다 오래되면 배치가 다시 받아온다(초). 기본 20시간.
PRICE_MAX_AGE=72000

# 조립된 리포트 응답 캐시 수명(초).
REPORT_TTL=86400

# 몬테카를로 상한. 올리면 CPU와 응답시간이 비례해서 늘어난다.
DEFAULT_SIMS=5000
MAX_SIMS=50000
