# EC2의 /opt/stock-metrics/.env 로 복사해 쓴다. 저장소에 커밋하지 말 것.

# --- 필수 -------------------------------------------------------------------
# Caddy가 이 도메인으로 인증서를 발급받는다. DNS가 먼저 이 인스턴스를
# 가리키고 있어야 한다.
DOMAIN=mulmit.com

# DNS에 www 레코드를 뒀다면 여기도 채운다. Caddy가 www용 인증서를 따로 받아
# apex로 301 리다이렉트한다. 비워 두면 www는 서비스하지 않는다.
WWW_DOMAIN=www.mulmit.com

# bootstrap.sh가 무작위로 채운다. 직접 정하지 말 것.
POSTGRES_PASSWORD=

# GitHub Actions가 배포할 때마다 덮어쓴다. 최초 기동용으로만 채워 둔다.
IMAGE=ghcr.io/subeom7/mulmit:latest

# --- 권리 게이트 -------------------------------------------------------------
# 이 값들은 수집뿐 아니라 공개 API의 서빙까지 결정합니다. false면 DB에 과거
# 행이 남아 있어도 값이 밖으로 나가지 않습니다. 판정 근거는
# docs/DATA_SOURCE_REGISTER.md에 공급자별로 기록합니다.

# Yahoo/yfinance 기반 레거시 분석은 공개 재배포 권리를 확보한 사설 환경에서만
# 명시적으로 켜세요. 공개 배포 기본값은 false입니다.
LEGACY_PRICE_DATA_ENABLED=false

# Hyperliquid HIP-3 / trade.xyz 합성 무기한선물 값의 공개 표시 여부입니다.
# API가 키 없이 열려 있다는 사실은 재표시 권리가 아닙니다. 코드 기본값은
# false이고, 서면 확인 전 현행 화면을 유지하기로 결정한 경우에만 여기서
# true로 두세요. 그 결정과 재검토 예정일은 source register에 남깁니다.
HIP3_PUBLIC_DISPLAY_ENABLED=false

# HIP-3 일봉 이력(candleSnapshot 1d, 1년, 6시간 주기). 실현 변동성 카드·교차 상관·
# 코인 상세 차트의 입력입니다. 위 공개 표시 게이트와 별개로 켭니다 — 등록부
# DS-2026-001 개정(무응답은 OFF가 아니고 명시적 거절만 OFF)에 따른 결정입니다.
HIP3_HISTORY_ENABLED=false

# 크립토 섹션 (/crypto, /api/crypto/*). 페이지 노출 스위치입니다. Hyperliquid 자체
# 무기한선물 값은 위 HIP3_PUBLIC_DISPLAY_ENABLED와 같은 게이트·같은 고지를 따릅니다.
# 판정과 소스별 약관 기록은 docs/PLAN_CRYPTO_SECTION.md §3.
CRYPTO_SECTION_ENABLED=false

# alternative.me 크립토 공포·탐욕 지수 relay. 발행자 약관이 "데이터 바로 옆에 출처를
# 표시하면 상업적 이용 허용"이라고 명시하며(2026-08-21 확인), 응답이 그 출처 문구를
# 동봉하고 화면이 값 옆에 고정합니다. 키 없음, 일 1회 갱신 지수를 시간 단위로 확인.
# https://alternative.me/crypto/fear-and-greed-index/
ALTERNATIVE_ME_ENABLED=false

# CoinMarketCap 글로벌 메트릭(BTC·ETH 도미넌스, 총시총). 가격표(2026-08-21)에
# "Commercial use rights — the free Basic tier included", 15,000 credits/월, 50 req/분.
# 키 발급 시 Commercial Terms(출처 문구·독립 재배포 금지)를 확인하고 등록부 §3.20에
# 기록한 뒤 켜세요. 키는 ingest만 씁니다. 출처 문구는 값 옆에 고정 표시됩니다.
CMC_ENABLED=false
CMC_API_KEY=
CMC_ATTRIBUTION_TEXT=Data provided by CoinMarketCap
# USDT·USDC 유통 공급(v2/cryptocurrency/quotes/latest, 1크레딧/회) 갱신 주기(초). 기본 1시간 → 월 ≈ 720크레딧.
CMC_STABLECOIN_MAX_AGE=3600

# 업비트(두나무) 원화 시세 · 김치프리미엄. 키 없음(공개 시세 API, IP당 10회/초).
# Open API 이용약관 §5가 데이터 저작권을 두나무에 두고 재표시를 허가도 금지도 하지 않아
# pending_rights입니다 — 두나무 서면 회신 또는 운영자 위험수용 결정(등록부 §3.19 템플릿)을
# 기록한 뒤에만 true로 두세요.
UPBIT_ENABLED=false

# 가스·수수료 스트립(이더리움·Base·Arbitrum). 퍼블릭 RPC는 약관상 쓰지 않고(등록부 §3.21)
# 운영자 본인 RPC 계정(예: Alchemy 무료 티어 — 월 30M CU, "low-traffic production apps" 적합)의
# HTTPS URL을 넣습니다. URL에 키가 들어가므로 web 컨테이너에만 전달되고 응답·로그에 나가지 않습니다.
CHAIN_GAS_ENABLED=false
CHAIN_RPC_ETHEREUM_URL=
CHAIN_RPC_BASE_URL=
CHAIN_RPC_ARBITRUM_URL=
CHAIN_RPC_PROVIDER_NAME=

# Federal Reserve Bank of New York (SOFR, EFFR, 익일물 역레포). 키가 필요 없습니다.
# NY Fed 이용약관이 자동 접근, 저장, 복제·배포, 파생 작업을 업무 목적으로 명시적으로
# 허가합니다. 조건은 지정된 출처 문구를 값과 함께 표시하는 것이고, 코드가 이를
# 응답의 rights.notice로 자동 포함합니다. https://www.newyorkfed.org/privacy/termsofuse
NYFED_ENABLED=false

# Board of Governors 통계 릴리스 (H.15 금리). 키가 필요 없습니다.
# Board는 Data Download Program을 폐지하고 FRED로 유도하는 중이지만, 전환 공지가
# "Historical data will remain available for download as XML files on statistical
# release pages"라고 명시해 그 경로를 씁니다. 폐지 일정이 있으므로 재확인 필요.
# https://www.federalreserve.gov/data/data-download-fred-information.htm
FEDBOARD_ENABLED=false

# U.S. Bureau of Labor Statistics (실업률). 키는 선택입니다.
# BLS 약관이 "everything that we publish... is in the public domain"이라고 직접
# 명시하며, 조건은 출처 표기뿐입니다. https://www.bls.gov/bls/linksite.htm
# 키가 없으면 하루 25회·10년, 있으면 500회·20년입니다.
BLS_ENABLED=false
BLS_API_KEY=

# 미 재무부 금융연구국(OFR) 금융스트레스지수 — 종합과 5개 범주. 키가 필요 없습니다.
# 연방 저작물이라 OFR Legal Notices가 저작권을 주장하지 않고 출처 표기만 요청합니다.
# 재무부 인장·엠블럼 사용과 보증 암시는 금지입니다. 하루 한 번 갱신되는 CSV 하나가
# 모든 계열을 담습니다. 표시할 권리가 없는 VIX·하이일드 카드의 대체 lane입니다
# (등록부 §3.17). https://www.financialresearch.gov/legal-notices/
OFR_ENABLED=false

# 금융위원회 공공데이터 (코스피·코스닥 지수, 삼성전자·SK하이닉스 종가).
# data.go.kr에 세 데이터셋 모두 이용허락범위 "제한 없음"·비용 "무료"로 등록되어
# 있습니다. 이는 KRX OPEN API 약관과 별개의, 더 넓은 허락입니다.
# https://www.data.go.kr/data/15094808/openapi.do (주식시세정보)
# https://www.data.go.kr/data/15094807/openapi.do (지수시세정보)
# 키는 data.go.kr에서 활용신청 후 발급됩니다. 인코딩·디코딩 키 어느 쪽을 넣어도
# 동작합니다. 기준일 다음 영업일 13시 이후 공개되는 장 마감값이며 실시간이 아닙니다.
FSC_ENABLED=false
FSC_API_KEY=

# 한국은행 경제통계시스템(ECOS) — 한국 거시 lane(미국 FRED의 대칭축).
# 인증키를 "영리" 이용형태로 신청해 승인받은 뒤에만 켜세요. 승인 증빙과 서빙 계열은
# 등록부 §3.16에 기록합니다. https://ecos.bok.or.kr/api/
ECOS_ENABLED=false
ECOS_API_KEY=

# 금융감독원 Open DART (임원·주요주주 소유상황 보고 — 한국판 Form 4).
# 법정 공시 개방 API. 약관은 재배포 금지 조항 없이 허용량 제한(홈페이지 게시)을
# 둡니다. 키는 opendart.fss.or.kr에서 발급받으며, 값을 가공 없이 전달하고
# 출처·원문 링크를 함께 표시합니다. https://opendart.fss.or.kr/intro/terms.do
DART_ENABLED=false
DART_API_KEY=

# GDELT 뉴스 메타데이터 — 뉴스의 영문 축. 키가 필요 없습니다.
# 약관이 상업 이용과 재배포를 명시적으로 허용하며 조건은 인용과 원문 링크입니다.
# 제목·출처·링크만 쓰고 본문은 전달하지 않습니다. 15분 벌크 파일 주기에 맞춰
# 갱신합니다(등록부 §6.1).
GDELT_ENABLED=false

# 정부 보도자료 RSS(금융위·기획재정부) — 뉴스의 한국어 축. 키가 필요 없습니다.
# 기관이 구독·연동 목적으로 공표하는 피드에서 제목·기관명·링크만 씁니다. 본문을
# 쓰려면 공공누리 유형을 먼저 확인해야 하므로 지금은 무전달이 안전선입니다.
# 금융위 피드는 게시일이 없어 최초 수집 시각(first_seen)으로 표기합니다.
KR_PRESS_ENABLED=false

# SEC EDGAR 지분공시(Form 3/4/5). EDGAR는 미국 연방정부 공시 시스템이고 SEC는
# 누구나 무료로 접근·다운로드할 수 있다고 안내합니다. 대신 자동 접근에는 조건이
# 있습니다. 연락처가 담긴 User-Agent 선언이 필수이고 초당 10요청을 넘지 않아야
# 합니다. USER_AGENT를 비워 두면 ENABLED=true여도 lane이 닫힌 채 유지됩니다.
# https://www.sec.gov/os/accessing-edgar-data
SEC_EDGAR_ENABLED=false
SEC_EDGAR_USER_AGENT=
# 배치가 항상 최신으로 유지할 티커. 사용자가 검색한 티커는 자동으로 대기열에 붙습니다.
SEC_EDGAR_TICKERS=AAPL,MSFT,NVDA,GOOGL,TSLA

# 미 하원 서기국 재정공시 — PTR(STOCK Act 거래보고). 키가 없고 게이트만 있습니다.
# 법정 공시이며, EIGA §105(c)가 상업 목적 이용을 금지하되 "news and communications
# media의 일반 공중 배포"를 명시적으로 제외합니다. 그 제한을 응답과 화면에 원문
# 고지로 실어 다운스트림 이용자에게도 전달합니다. 상원 eFD는 봇 차단(403)이라
# 연결하지 않습니다 — 우회하지 않습니다(등록부 §3.14).
US_PTR_ENABLED=false

# --- 선택 -------------------------------------------------------------------

# gunicorn 워커 수. t4g.small(2 vCPU)이면 2가 적정.
WEB_CONCURRENCY=2

# 수집 주기(초)와 1회 실행당 티커 수. 야후가 자주 막히면 배치를 줄이고
# 간격을 늘린다.
INGEST_INTERVAL=3600
INGEST_BATCH_SIZE=40
INGEST_DELAY=1.5

# 실험적 FRED 어댑터. 현행 API 약관은 API 콘텐츠의 저장·캐시·제3자 제공을
# 제한하므로 공개 배포에서는 false를 유지하세요. 서면 허가 또는 허용된
# 대체 피드가 확보된 사설 환경에서만 검토합니다. false면 수집과 서빙이 모두
# 막히므로 /api/market/macro는 구조화된 503을 반환합니다.
FRED_ENABLED=false
FRED_API_KEY=
FRED_MAX_AGE=21600
FRED_TIMEOUT=15
FRED_RETRIES=2
FRED_INGEST_DELAY=0.1

# KRX 관리자에게 공개 대시보드 용도를 승인받은 뒤에만 활성화하세요.
# OPEN API 키만으로 제3자 재배포 권한이 생기지는 않습니다.
KRX_ENABLED=false
KRX_API_KEY=
KRX_TIMEOUT=15
KRX_RETRIES=2

# 조회가 없어도 항상 최신으로 유지할 티커
SEED_TICKERS=AAPL,MSFT,SPY,QQQ

# 가격이 이보다 오래되면 배치가 다시 받아온다(초). 기본 20시간.
PRICE_MAX_AGE=72000

# 조립된 리포트 응답 캐시 수명(초).
REPORT_TTL=86400

# 몬테카를로 상한. 올리면 CPU와 응답시간이 비례해서 늘어난다.
DEFAULT_SIMS=5000
MAX_SIMS=50000

# --- 바이오 섹션 (ROADMAP #8, docs/PLAN_BIO_SECTION.md) — 전부 기본 OFF ---
# 페이지·라우트 노출
BIO_SECTION_ENABLED=false
# ClinicalTrials.gov 워치리스트(키 없음, 6시간 주기, 약관 4조건은 응답에 동봉)
CLINICALTRIALS_ENABLED=false
# openFDA 원 신청 승인(공개 도메인 CC0, 하루 주기). 키는 선택(무료) — ingest 전용
OPENFDA_ENABLED=false
OPENFDA_API_KEY=
# Phase 2 — PubMed 서지(임상별 논문, 메타데이터만; NCBI 정책: 3 req/s·야간 창·tool/email) / FDA 자문위 공고(Federal Register, 키 없음)
PUBMED_ENABLED=false
# NCBI 연락용 이메일(정책상 권장, ingest 전용)·선택 API 키(10 req/s)
NCBI_EMAIL=
NCBI_API_KEY=
FEDERAL_REGISTER_ENABLED=false
# 식약처 의약품 품목허가(공공데이터포털 15095677, 이용허락 제한 없음). 키는 data.go.kr 계정 단위 — 비우면 FSC_API_KEY를 그대로 쓴다(ingest 전용)
MFDS_ENABLED=false
MFDS_API_KEY=
